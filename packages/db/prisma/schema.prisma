generator client {
  provider      = "prisma-client-js"
  // native = dev machine; debian-openssl-3.0.x = the Ubuntu 24.04 (Playwright) Docker images.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  member
  // Signed up through the public funnel (step 8): sees only their own website.
  customer
}

enum Audience {
  client
  expert
}

enum AuditStatus {
  queued
  running
  completed
  failed
  cancelled
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String?
  passwordHash String
  role         Role             @default(member)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  audits       Audit[]
  account      CustomerAccount?
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Project {
  id            String            @id @default(cuid())
  name          String
  domain        String            @unique
  gscProperty   String?
  ga4Property   String?
  templateRules Json?
  businessName  String?
  phone         String?
  address       String?
  serviceArea   Json?
  services      String[]
  gbpUrl        String?
  createdAt     DateTime          @default(now())
  audits        Audit[]
  accounts      CustomerAccount[]
}

model ApiUsage {
  id        String   @id @default(cuid())
  auditId   String?
  provider  String
  endpoint  String
  units     Int
  costUsd   Decimal?
  createdAt DateTime @default(now())

  @@index([provider, createdAt])
}

model GscConnection {
  id              String   @id @default(cuid())
  googleEmail     String
  refreshTokenEnc String
  scopes          String
  createdAt       DateTime @default(now())
}

model Audit {
  id                String          @id @default(cuid())
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id])
  // Optional until login exists (plan step 2); then set from the session.
  createdById       String?
  createdBy         User?           @relation(fields: [createdById], references: [id])
  url               String
  audience          Audience
  crawlLimit        Int // "Page limit" in the UI: 10 | 20 | 30 | 40 | 50
  notifyEmail       String? // "Email me the full report" (optional)
  source            String          @default("team") // team | public (free audit) | customer
  jsRendering       Boolean
  auditMode         String          @default("quick") // quick | deep
  aiRecommendations Boolean         @default(false)
  /// The validated new-audit form input, so an audit can be re-run exactly.
  input             Json?
  costUsd           Decimal?        @db.Decimal(10, 5)
  gscProperty       String?
  gscRangeDays      Int?
  status            AuditStatus     @default(queued)
  progress          Int             @default(0)
  dfsTaskId         String?
  pagesCrawled      Int?
  overallScore      Int?
  categoryScores    Json?
  report            Json?
  pdfPath           String?
  error             String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime        @default(now())
  steps             AuditStep[]
  results           RuleResultRow[]
  rawData           RawData[]

  @@index([projectId, createdAt])
  @@index([source, createdAt])
}

model AuditStep {
  id         String    @id @default(cuid())
  auditId    String
  audit      Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  name       String
  status     String
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  /// Short progress text, e.g. "8 of 10 pages checked".
  detail     String?
  meta       Json?

  @@unique([auditId, name])
}

model RawData {
  id        String   @id @default(cuid())
  auditId   String
  audit     Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  source    String
  key       String
  gz        Bytes
  createdAt DateTime @default(now())

  @@index([auditId, source])
}

model RuleResultRow {
  id              String @id @default(cuid())
  auditId         String
  audit           Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  ruleId          String
  status          String
  severity        String
  affectedCount   Int?
  applicableCount Int?
  metrics         Json?
  examples        Json
  message         Json

  @@index([auditId])
  @@index([ruleId])
}

/// A customer who signed up through the public funnel (step 8): trial, chosen plan and
/// everything entered in the 5-step onboarding. No payment is taken; the team invoices.
model CustomerAccount {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  phone           String?
  plan            String // autopilot | growth
  status          String    @default("trial") // trial | active | cancelled
  trialEndsAt     DateTime
  website         String?
  /// Growth plan: up to 2 more websites (3 in total).
  extraWebsites   String[]
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id])
  sourceAuditId   String? // the free audit they signed up from
  country         String?
  areas           String[]
  otherCountries  Boolean   @default(false)
  language        String?
  services        String[]
  competitors     String[]
  connections     String[] // requested: gsc | ga4 | gbp | cms
  consentChanges  Boolean   @default(false)
  consentAt       DateTime?
  onboardingStep  Int       @default(2) // next step to show; 6 = finished
  onboardedAt     DateTime?
  lastAutoAuditAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// AI check results keyed by a hash of exactly what was sent (step 7), so unchanged pages
/// are not paid for twice. Safe to empty at any time.
model AiCache {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
}

/// Module 3 competitor workspace for one website (keyed by its domain, without www):
/// settings, core searches and the competitor list as one document (see @seo/core
/// CompetitorWorkspace). Shared by the team's project pages and the customer's /my area.
model CompetitorWorkspace {
  domain    String    @id
  data      Json
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Module 4 keyword workspace for one website (keyed by its domain, without www): seeds,
/// keywords, clusters and AI prompts as one document (see @seo/core KeywordWorkspace).
model KeywordWorkspace {
  domain    String    @id
  data      Json
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// A customer's own Google connection (Search Console + Analytics 4, read-only), one per
/// customer user. The refresh token is AES-256-GCM encrypted with ENCRYPTION_KEY (like the
/// agency GscConnection). `sites` holds the chosen properties per website domain:
/// { "example.com": { gscProperty, ga4Property, ga4Name, chosenAt } }.
model CustomerGoogle {
  userId          String   @id
  googleEmail     String
  refreshTokenEnc String
  scopes          String
  sites           Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Module 5 keyword-to-page mapping for one website (keyed by its domain): one row per topic
/// with the page, action, drafts, links and schema to add (see @seo/core MappingWorkspace).
model MappingWorkspace {
  domain    String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Module 12: one action plan per website (JSON document, ≤ a few hundred actions).
model ActionWorkspace {
  domain    String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Module 6: the latest deep competitor analysis per website (JSON document).
model CompetitorAnalysis {
  domain    String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Site connection (spec §16.5): the client's WordPress or Shopify site, keyed by its domain.
/// Credentials inside `data.secret` are AES-256-GCM encrypted (see @seo/core SiteConnection).
model SiteConnection {
  domain    String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One JSON document per website and kind (Module 8 "backlinks": audit + outreach list; Module 9
/// "local": the local audit). See @seo/core BacklinkWorkspace and LocalAudit.
model SiteDocument {
  kind      String
  domain    String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([kind, domain])
}

/// Autopilot phase 1: the connected WordPress site's own inventory (every published page, post,
/// product and category with its SEO fields), read from the Connector plugin and refreshed weekly.
/// `accountId` is the customer account's id, or "team" for agency client sites.
model SiteInventory {
  accountId   String
  domain      String
  data        Json
  refreshedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([accountId, domain])
  @@index([domain])
}

/// WordPress autopilot: per account and website, the work items (exact changes) and the runs that
/// applied them (see @seo/core WorkItem, RunSummary).
model WpAutopilot {
  accountId String
  domain    String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([accountId, domain])
  @@index([domain])
}
