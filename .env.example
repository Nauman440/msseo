# Template only — copy to .env and fill in there. NEVER put real keys in this file (it is committed).

# App
APP_URL=http://localhost:3005
AUTH_SECRET=                 # openssl rand -base64 32
ENCRYPTION_KEY=              # 32-byte base64, for GSC refresh tokens
FEATURE_SALES_SECTIONS=false

# Database / queue (leave empty locally: audits then run in-process and are saved in .data/)
DATABASE_URL=
REDIS_URL=

# DataForSEO — login = account email/API login; password = API password from app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com   # live; https://sandbox.dataforseo.com = free test data

# Google
PAGESPEED_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3005/api/gsc/callback

# Email ("Email me the full report")
RESEND_API_KEY=
EMAIL_FROM=                  # e.g. SEO Audit <audit@yourdomain.com>, domain verified with the provider

# AI (Phase 4)
ANTHROPIC_API_KEY=

# Worker
WORKER_CONCURRENCY=2
CRAWL_TIMEOUT_MINUTES=45
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=seo-audit-files
