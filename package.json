{
  "name": "seo-audit-tool",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "pdf:sample": "pnpm --filter @seo/worker pdf:sample",
    "test:e2e": "pnpm --filter @seo/web test:e2e",
    "check:secrets": "node scripts/check-secrets.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:wp": "php integrations/wordpress/tests/signing-test.php",
    "test:wp:e2e": "bash integrations/wordpress/tests/local/setup.sh && cd packages/db && tsx ../../integrations/wordpress/tests/e2e.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
